{
  "name": "@codeminity/ui-kit-vue",
  "version": "0.0.1",
  "private": false,
  "description": "Vue bindings for @codeminity/ui-kit-core, with v-model support for form components.",
  "keywords": [
    "vue",
    "web-components",
    "custom-elements",
    "ui-library",
    "design-system",
    "typescript"
  ],
  "license": "MIT",
  "author": "Masoud Fooladi",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/codeminity/ts-platform.git",
    "directory": "packages/ui-kit/vue"
  },
  "homepage": "https://github.com/codeminity/ts-platform/tree/main/packages/ui-kit/vue#readme",
  "bugs": {
    "url": "https://github.com/codeminity/ts-platform/issues"
  },
  "type": "module",
  "sideEffects": true,
  "engines": {
    "node": "^22.13.0 || >=24.0.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "types": "./dist/index.d.ts",
  "main": "./dist/index.js",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "pnpm run build:js && pnpm run build:types",
    "build:js": "tsup",
    "build:types": "tsc -p tsconfig.build-types.json --emitDeclarationOnly",
    "dev": "tsup --watch",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@codeminity/ui-kit-core": "workspace:*"
  },
  "peerDependencies": {
    "vue": "^3.5.0"
  },
  "devDependencies": {
    "@vue/test-utils": "^2.4.11",
    "tsup": "^8.5.1",
    "vue": "^3.5.41"
  }
}
