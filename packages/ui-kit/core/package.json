{
  "name": "@codeminity/ui-kit-core",
  "version": "0.1.0",
  "private": false,
  "description": "Framework-agnostic UI components (Web Components / Custom Elements) for the Codeminity ecosystem — no Vue, React, or Angular required.",
  "keywords": [
    "web-components",
    "custom-elements",
    "lit",
    "ui-library",
    "design-system",
    "typescript"
  ],
  "license": "MIT",
  "author": "Masoud Fooladi",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/codeminity/ts-platform.git",
    "directory": "packages/ui-kit/core"
  },
  "homepage": "https://github.com/codeminity/ts-platform/tree/main/packages/ui-kit/core#readme",
  "bugs": {
    "url": "https://github.com/codeminity/ts-platform/issues"
  },
  "type": "module",
  "sideEffects": true,
  "engines": {
    "node": "^22.13.0 || >=24.0.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "types": "./dist/index.d.ts",
  "main": "./dist/index.js",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "pnpm run build:js && pnpm run build:types",
    "build:js": "tsup",
    "build:types": "tsc -p tsconfig.build-types.json --emitDeclarationOnly",
    "dev": "tsup --watch",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "lit": "^3.3.3"
  },
  "devDependencies": {
    "tsup": "^8.5.1"
  }
}
