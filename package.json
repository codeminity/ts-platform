{
  "name": "ts-platform",
  "private": true,
  "type": "module",
  "description": "A TypeScript monorepo platform for building shared packages, tools, and infrastructure across the Codeminity ecosystem.",
  "license": "MIT",
  "author": "Masoud Fooladi",
  "repository": {
    "type": "git",
    "url": "https://github.com/codeminity/ts-platform"
  },
  "homepage": "https://github.com/codeminity/ts-platform#readme",
  "bugs": {
    "url": "https://github.com/codeminity/ts-platform/issues"
  },
  "sideEffects": false,
  "engines": {
    "node": "^22.13.0 || >=24.0.0"
  },
  "packageManager": "pnpm@11.21.0",
  "scripts": {
    "dev": "turbo dev",
    "build": "turbo build",
    "prepublishOnly": "pnpm build",
    "prepare": "husky",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "lint": "eslint . --cache --cache-location .eslintcache",
    "validate:lit-css": "pnpm --filter @codeminity/ui-kit run validate:lit-css",
    "format": "prettier --write . --cache --cache-location .prettiercache --cache-strategy content",
    "validate:format": "prettier --check . --cache --cache-location .prettiercache --cache-strategy content",
    "outdated": "pnpm -r outdated --include-github-actions",
    "changeset": "changeset",
    "version-packages": "changeset version",
    "release": "changeset publish",
    "validate:api-exports": "tsx scripts/validate-api-exports-run.ts",
    "typecheck": "turbo run typecheck && tsx scripts/typecheck-extras-run.ts",
    "verify:package": "tsx scripts/verify-package-run.ts",
    "verify:packages": "tsx scripts/verify-packages-run.ts",
    "validate:docs": "tsx scripts/validate-docs-run.ts",
    "validate:deps": "tsx scripts/validate-deps-run.ts",
    "validate:node-resolution": "tsc -p tsconfig.esm-strict.json --noEmit --incremental --tsBuildInfoFile tsconfig.esm-strict.json.tsbuildinfo",
    "validate:socket": "socket ci",
    "validate:size": "size-limit",
    "validate:changeset": "changeset status --since=origin/main",
    "release-notes": "tsx scripts/release-notes-run.ts",
    "sbom": "pnpm sbom --sbom-format cyclonedx --prod --split --out sbom/%s.cdx.json",
    "test:e2e": "playwright test --config=e2e/browser/playwright.config.ts",
    "test:mutation": "tsx scripts/test-mutation-run.ts",
    "test:mutation:full": "tsx node_modules/@stryker-mutator/core/bin/stryker.js run stryker.config.ts",
    "bench": "vitest bench --run",
    "bench:baseline": "vitest bench --run --outputJson bench-baseline.json",
    "bench:compare": "vitest bench --run --compare bench-baseline.json",
    "full-check": "tsx scripts/full-check-run.ts",
    "clean": "node --import tsx scripts/clean-run.ts"
  },
  "devDependencies": {
    "@changesets/cli": "^3.0.0",
    "@commitlint/cli": "^21.2.2",
    "@commitlint/config-conventional": "^21.2.2",
    "@commitlint/types": "^21.2.0",
    "@eslint/js": "^10.0.1",
    "@happy-dom/global-registrator": "20.11.2",
    "@microsoft/api-extractor": "^7.58.12",
    "@playwright/test": "^1.62.1",
    "@size-limit/preset-small-lib": "^13.0.3",
    "@stryker-mutator/api": "^9.6.1",
    "@stryker-mutator/core": "^9.6.1",
    "@stryker-mutator/vitest-runner": "^9.6.1",
    "@types/node": "^26.2.0",
    "@vitest/coverage-v8": "4.1.10",
    "dependency-cruiser": "^18.2.0",
    "esbuild": "^0.28.2",
    "eslint": "^10.8.1",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-import-x": "^4.17.1",
    "fast-check": "^4.9.0",
    "globals": "^17.11.0",
    "globby": "^16.2.3",
    "happy-dom": "^20.11.2",
    "husky": "^9.1.7",
    "jiti": "^2.7.0",
    "lint-staged": "^17.3.0",
    "prettier": "^3.9.6",
    "publint": "^0.3.23",
    "size-limit": "^13.0.3",
    "socket": "^1.1.157",
    "tsx": "^4.23.12",
    "turbo": "^2.10.9",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.67.0",
    "vitest": "4.1.10"
  }
}
